<!DOCTYPE html>
<html lang="id" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>ROOM-CHAT</title>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  
  <style>
    :root {
      --font-family: 'Cinzel', serif, -apple-system, BlinkMacSystemFont, sans-serif;
      --chat-font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      --bg-main: #0a0407;
      --card-bg: rgba(20, 10, 15, 0.75);
      --card-border: rgba(217, 119, 6, 0.3);
      --text-main: #f8fafc;
      --text-muted: #a1a1aa;
      --primary: #f59e0b;
      --primary-hover: #d97706;
      --input-bg: rgba(30, 15, 22, 0.65);
      --msg-other: rgba(45, 20, 30, 0.85);
      --msg-mine: #b45309;
      --msg-mine-text: #ffffff;
      --reply-bg: rgba(255, 255, 255, 0.1);
      --reply-text: #e2e8f0;
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.5);
      --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.6);
      --modal-overlay: rgba(0, 0, 0, 0.8);
    }

    [data-theme="dark"] {
      --bg-main: #070204;
      --card-bg: rgba(18, 8, 12, 0.82);
      --card-border: rgba(245, 158, 11, 0.35);
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --primary: #fbbf24;
      --primary-hover: #f59e0b;
      --input-bg: rgba(25, 10, 16, 0.75);
      --msg-other: rgba(40, 15, 24, 0.9);
      --msg-mine: #d97706;
      --msg-mine-text: #ffffff;
      --reply-bg: rgba(255, 255, 255, 0.12);
      --reply-text: #e2e8f0;
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.6);
      --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.8);
      --modal-overlay: rgba(0, 0, 0, 0.85);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: var(--font-family); transition: background-color 0.2s ease, color 0.2s ease; }
    body { background-color: var(--bg-main); color: var(--text-main); min-height: 100vh; min-height: 100dvh; display: flex; justify-content: center; align-items: center; overflow: hidden; position: relative; }

    #bg-video {
      position: fixed;
      top: 50%;
      left: 50%;
      min-width: 100%;
      min-height: 100%;
      width: auto;
      height: auto;
      z-index: -2;
      transform: translate(-50%, -50%);
      object-fit: cover;
      filter: brightness(0.65) contrast(1.1);
    }

    #toast-container { position: fixed; top: 20px; left: 50%; transform: translateX(-50%); z-index: 9999; display: flex; flex-direction: column; gap: 10px; pointer-events: none; }
    .toast { min-width: 280px; padding: 12px 20px; border-radius: 12px; background: var(--card-bg); backdrop-filter: blur(12px); border: 1px solid var(--card-border); color: var(--text-main); box-shadow: 0 10px 30px rgba(0,0,0,0.5); display: flex; align-items: center; gap: 12px; font-size: 0.9rem; font-weight: 600; opacity: 0; transform: translateY(-20px); transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55); pointer-events: auto; }
    .toast.show { opacity: 1; transform: translateY(0); }
    .toast.success { border-left: 4px solid #10b981; }
    .toast.error { border-left: 4px solid #ef4444; }
    .toast.info { border-left: 4px solid var(--primary); }

    .theme-toggle-btn { position: fixed; top: 16px; right: 16px; background: var(--card-bg); border: 1px solid var(--card-border); color: var(--text-main); width: 42px; height: 42px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: var(--shadow-sm); z-index: 100; font-size: 1.2rem; backdrop-filter: blur(8px); }

    .made-by-credit { font-size: 0.7rem; color: var(--text-muted); letter-spacing: 0.4px; opacity: 0.75; }
    .made-by-credit span { color: var(--primary); font-weight: 700; }
    .auth-made-by-credit { margin-top: 18px; }
    .header-title-block { display: flex; flex-direction: column; gap: 1px; line-height: 1.15; }
    .header-made-by-credit { font-size: 0.62rem; }
    .glass-card { background: var(--card-bg); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); border: 1px solid var(--card-border); border-radius: 20px; box-shadow: var(--shadow-lg); }
    .hidden { display: none !important; }

    .auth-container { width: 90%; max-width: 400px; padding: 36px 28px; text-align: center; }
    .auth-container h2 { font-size: 1.6rem; font-weight: 700; margin-bottom: 24px; color: var(--primary); text-shadow: 0 0 10px rgba(245, 158, 11, 0.4); }
    input[type="text"], input[type="email"], input[type="password"], input[type="file"], select { width: 100%; padding: 12px 16px; margin: 8px 0; background: var(--input-bg); border: 1px solid var(--card-border); border-radius: 12px; color: var(--text-main); font-size: 0.9rem; outline: none; }
    button.btn-primary { width: 100%; padding: 12px 20px; margin-top: 12px; background: var(--primary); border: none; border-radius: 12px; color: #000; font-weight: 700; font-size: 0.9rem; cursor: pointer; transition: transform 0.1s ease, background 0.2s ease; }
    button.btn-primary:hover { background: var(--primary-hover); }
    button.btn-secondary { background: var(--input-bg); border: 1px solid var(--card-border); color: var(--text-main); padding: 8px 14px; border-radius: 10px; font-weight: 600; font-size: 0.85rem; cursor: pointer; white-space: nowrap; }

    .btn-loading { position: relative; pointer-events: none; color: transparent !important; }
    .btn-loading::after { content: ""; position: absolute; width: 18px; height: 18px; top: 50%; left: 50%; margin-top: -9px; margin-left: -9px; border: 2px solid rgba(0, 0, 0, 0.3); border-radius: 50%; border-top-color: #000000; animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
 
    .chat-container { width: 95vw; max-width: 900px; height: 90vh; display: flex; flex-direction: column; overflow: hidden; }
    
    .chat-header { padding: 12px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--card-border); gap: 10px; background: rgba(0, 0, 0, 0.2); }
    .header-title-container { display: flex; align-items: center; gap: 10px; }
    .header-title-container h3 { font-size: 1.1rem; font-weight: 700; white-space: nowrap; color: var(--primary); }
    
    .online-badge { background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); color: #10b981; font-size: 0.75rem; font-weight: 700; padding: 4px 10px; border-radius: 20px; display: flex; align-items: center; gap: 6px; white-space: nowrap; }
    .online-dot { width: 8px; height: 8px; background-color: #10b981; border-radius: 50%; box-shadow: 0 0 8px #10b981; }

    .header-actions { display: flex; align-items: center; gap: 12px; }
    .user-profile-summary { display: flex; align-items: center; gap: 8px; padding: 4px 6px; border-radius: 30px; cursor: pointer; }
    .avatar { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; display: block; border: 1.5px solid var(--primary); }
    
    .avatar-wrapper { position: relative; display: inline-block; flex-shrink: 0; }
    .admin-crown { position: absolute; top: -10px; left: 50%; transform: translateX(-50%) rotate(-12deg); font-size: 14px; background: transparent; border: none; box-shadow: none; filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.5)); z-index: 2; pointer-events: none; }
 
    .chat-messages { flex: 1; padding: 16px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; position: relative; }
    .message { display: flex; gap: 8px; max-width: 85%; align-items: flex-end; position: relative; }
    .message.mine { align-self: flex-end; flex-direction: row-reverse; }
 
    .message-content { 
      background: var(--msg-other); 
      color: var(--text-main); 
      padding: 6px 10px 8px 12px; 
      border-radius: 12px; 
      border-bottom-left-radius: 2px; 
      position: relative; 
      width: fit-content;
      max-width: 100%;
      cursor: pointer; 
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
      border: 1px solid rgba(255, 255, 255, 0.05);
    }
    .message.mine .message-content { 
      background: var(--msg-mine); 
      color: var(--msg-mine-text); 
      border-radius: 12px; 
      border-bottom-right-radius: 2px; 
      border-bottom-left-radius: 12px;
    }
    .message-content::after {
      content: "";
      display: table;
      clear: both;
    }
  
    .reply-quote { background: var(--reply-bg); border-left: 4px solid var(--primary); border-radius: 6px; padding: 4px 8px; margin-bottom: 6px; font-size: 0.82rem; width: 100%; box-sizing: border-box; }
    .message.mine .reply-quote { background: rgba(0, 0, 0, 0.25); border-left: 4px solid #ffffff; }
    .reply-quote-user { font-weight: 700; font-size: 0.75rem; margin-bottom: 2px; color: var(--primary); }
    .message.mine .reply-quote-user { color: #ffffff; }
    .reply-quote-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--reply-text); font-size: 0.78rem; font-weight: 500; }
    .message.mine .reply-quote-text { color: rgba(255, 255, 255, 0.9); }
 
    .message-actions { opacity: 0; pointer-events: none; transition: opacity 0.2s, transform 0.2s; transform: scale(0.9); }
    .message:hover .message-actions, .message.active-chat .message-actions { opacity: 1; pointer-events: auto; transform: scale(1); }
    .reply-btn { cursor: pointer; font-size: 0.75rem; background: var(--card-bg); border: 1px solid var(--card-border); color: var(--text-main); padding: 3px 6px; border-radius: 6px; align-self: center; }
 
    .read-more-btn { color: #fbbf24; font-weight: 600; cursor: pointer; margin-left: 4px; text-decoration: underline; display: inline-block; }
    .message.mine .read-more-btn { color: #fde68a; }
 
    .message.admin-msg .message-content { background: linear-gradient(135deg, rgba(120, 72, 20, 0.4), rgba(90, 55, 15, 0.5)); border: 1px solid rgba(217, 160, 60, 0.45); box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35); color: #f1e9dc; }

    .message.ai-msg .message-content { background: linear-gradient(135deg, rgba(70, 55, 105, 0.4), rgba(40, 55, 95, 0.45)); border: 1px solid rgba(168, 130, 220, 0.4); box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35); color: #ece9f7; }
    .ai-badge-icon { position: absolute; top: -10px; left: 50%; transform: translateX(-50%); font-size: 14px; background: transparent; border: none; box-shadow: none; filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.5)); z-index: 2; pointer-events: none; }
    .username-ai { color: #b9a4dd !important; font-weight: 700 !important; }
    .ai-badge { background: rgba(139, 105, 190, 0.8); color: #f1edfa; font-size: 0.6rem; padding: 1px 4px; border-radius: 4px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; }
    .username-tag { font-size: 0.75rem; font-weight: 700; margin-bottom: 2px; display: flex; align-items: center; gap: 4px; line-height: 1.2; }
    .username-admin { color: #d9a53c !important; font-weight: 700 !important; }
    .admin-badge { background: rgba(190, 140, 50, 0.85); color: #1a1206; font-size: 0.6rem; padding: 1px 4px; border-radius: 4px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; }

    .message-text { font-size: 0.88rem; line-height: 1.35; word-break: break-word; white-space: pre-wrap; display: inline; }
    .message-content, .message-content * { font-family: var(--chat-font); }
    .timestamp { font-size: 0.62rem; color: var(--text-muted); margin-top: 2px; margin-left: 8px; float: right; position: relative; top: 4px; opacity: 0.8; }
    .message.mine .timestamp { color: rgba(255, 255, 255, 0.75); }
   
    .chat-input-wrapper { border-top: 1px solid var(--card-border); background: rgba(0, 0, 0, 0.3); display: flex; flex-direction: column; }
    .reply-preview-container { padding: 8px 16px; background: var(--input-bg); border-bottom: 1px solid var(--card-border); display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; }
    .reply-preview-info { border-left: 3px solid var(--primary); padding-left: 8px; }
    .close-reply-btn { cursor: pointer; color: var(--text-muted); font-size: 1.1rem; border: none; background: transparent; }

    .chat-input-area { padding: 12px 16px; display: flex; gap: 10px; }
    .chat-input-area input { flex: 1; margin: 0; }
    .chat-input-area button { width: auto; padding: 0 20px; margin: 0; }
 
    .typing-indicator-container { padding: 4px 16px; font-size: 0.8rem; color: var(--text-muted); display: flex; align-items: center; gap: 8px; }
    .typing-dots { display: inline-flex; gap: 3px; }
    .typing-dots span { width: 4px; height: 4px; background: var(--primary); border-radius: 50%; animation: typingBounce 1.4s infinite ease-in-out; }
    .typing-dots span:nth-child(2) { animation-delay: 0.2s; }
    .typing-dots span:nth-child(3) { animation-delay: 0.4s; }
    @keyframes typingBounce { 0%, 80%, 100% { transform: translateY(0); } 40% { transform: translateY(-5px); } }
 
    .modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: var(--modal-overlay); backdrop-filter: blur(6px); display: flex; justify-content: center; align-items: center; z-index: 1000; padding: 16px; }
    .modal-content { width: 100%; max-width: 420px; padding: 24px; position: relative; }
    .close-modal { position: absolute; top: 18px; right: 20px; cursor: pointer; font-size: 1.2rem; color: var(--text-muted); width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
 
    .board { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 20px 0; }
    .cell { width: 70px; height: 70px; background: var(--input-bg); border: 1px solid var(--card-border); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.8em; font-weight: 700; cursor: pointer; color: var(--primary); }

    .c4-board-wrapper { background: #111827; padding: 12px; border-radius: 16px; margin: 16px 0; border: 2px solid var(--card-border); width: 100%; box-sizing: border-box; }
    .c4-board { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; width: 100%; }
    .c4-cell { aspect-ratio: 1 / 1; width: 100%; background: #374151; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s ease; box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.4); }
    .c4-cell:hover { background: #4b5563; transform: scale(1.05); }
    .c4-cell.red { background: #ef4444; box-shadow: inset 0 0 6px rgba(0,0,0,0.5); }
    .c4-cell.yellow { background: #eab308; box-shadow: inset 0 0 6px rgba(0,0,0,0.5); }
 
    @media (max-width: 600px) {
      body { padding: 0; align-items: flex-start; }
      .chat-container { width: 100vw; height: 100dvh; border-radius: 0; border: none; }
      .chat-header { padding: 10px 12px; }
      .header-title-container h3 { font-size: 0.95rem; }
      .online-badge { padding: 3px 8px; font-size: 0.7rem; }
      .btn-secondary { padding: 6px 10px; font-size: 0.78rem; }
      .user-profile-summary #my-username { max-width: 65px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.8rem; }
      .avatar { width: 32px; height: 32px; }
      .theme-toggle-btn { top: 10px; right: 10px; width: 36px; height: 36px; font-size: 1rem; }
      .header-made-by-credit { font-size: 0.58rem; }
      .auth-made-by-credit { font-size: 0.65rem; margin-top: 14px; }
    }

    @media (max-width: 380px) {
      .header-title-block { flex-direction: row; align-items: baseline; gap: 6px; }
      .header-made-by-credit { font-size: 0.52rem; opacity: 0.6; }
    }
  </style>
</head>
<body>

  <video autoplay muted loop playsinline id="bg-video">
    <source src="walpaper.mp4" type="video/mp4">
  </video>

  <div id="toast-container"></div>
  <button class="theme-toggle-btn" onclick="toggleTheme()" id="theme-btn">🌙</button>

  <div id="auth-section" class="glass-card auth-container">
    <h2>ROOM-CHAT</h2>
    <div id="form-username">
      <input type="text" id="user-input" placeholder="Username (huruf & angka)">
      <input type="password" id="pass-input" placeholder="Password (min. 6 karakter)">
      <button class="btn-primary" onclick="loginWithUsername()">Login / Daftar</button>
    </div>
    <div class="made-by-credit auth-made-by-credit">made with 🔥 by <span>DimasDwi</span></div>
  </div>

  <div id="chat-section" class="glass-card chat-container hidden">
    <div class="chat-header">
      <div class="header-title-container">
        <div class="header-title-block">
          <h3>💬 ROOM-CHAT</h3>
          <span class="made-by-credit header-made-by-credit">by <span>DimasDwi</span></span>
        </div>
        <div class="online-badge">
          <span class="online-dot"></span>
          <span id="online-count">1 Online</span>
        </div>
      </div>
      <div class="header-actions">
        <button class="btn-secondary" onclick="openGameHub()">🎮 Mabar</button>
        <div class="user-profile-summary" onclick="openProfileModal()">
          <div class="avatar-wrapper">
            <span id="my-crown" class="admin-crown hidden">👑</span>
            <img id="my-avatar" src="https://via.placeholder.com/36" class="avatar" alt="PP">
          </div>
          <span id="my-username" style="font-weight: 600;">User</span>
        </div>
      </div>
    </div>
    
    <div id="chat-messages" class="chat-messages"></div>

    <div id="typing-indicator" class="typing-indicator-container hidden">
      <div class="typing-dots">
        <span></span><span></span><span></span>
      </div>
      <span id="typing-text">Seseorang sedang mengetik...</span>
    </div>

    <div class="chat-input-wrapper">
      <div id="reply-preview" class="reply-preview-container hidden">
        <div class="reply-preview-info">
          <div style="font-size:0.75rem; font-weight:700; color:var(--primary);" id="reply-user-target">Membalas User</div>
          <div style="font-size:0.8rem; color:var(--text-muted);" id="reply-text-target">Pesan yang dibalas</div>
        </div>
        <button class="close-reply-btn" onclick="cancelReply()">&times;</button>
      </div>

      <div class="chat-input-area">
        <input type="text" id="message-input" placeholder="Ketik pesan... (pakai /ai atau /bot buat nanya AI)" oninput="handleTyping()" onkeypress="handleKeyPress(event)">
        <button class="btn-primary" onclick="sendMessage()">Kirim</button>
      </div>
    </div>
  </div>

  <div id="profile-modal" class="modal hidden">
    <div class="glass-card modal-content">
      <span class="close-modal" onclick="closeProfileModal()">&times;</span>
      <h3 style="text-align: center; font-weight: 700; color: var(--primary);">Edit Profil</h3>
      <div style="text-align:center; margin: 16px 0;">
        <img id="preview-img" style="width: 90px; height: 90px; border-radius: 50%; object-fit: cover; border: 3px solid var(--primary);" src="https://via.placeholder.com/90">
      </div>
      <label style="font-size: 0.8rem; font-weight: 600;">Username</label>
      <input type="text" id="edit-username-input">
      <label style="font-size: 0.8rem; font-weight: 600; margin-top: 10px; display: block;">Foto Profil</label>
      <input type="file" id="edit-avatar-file" accept="image/*" onchange="previewFile()">
      <button class="btn-primary" id="save-btn" onclick="saveProfile()">Simpan Profil</button>
      <button style="width:100%; background:transparent; border:none; color:#ef4444; margin-top:12px; font-weight: 600; cursor:pointer;" onclick="logout()">Logout</button>
    </div>
  </div>

  <div id="game-hub-modal" class="modal hidden">
    <div class="glass-card modal-content">
      <span class="close-modal" onclick="closeModal('game-hub-modal')">&times;</span>
      <h3 style="font-weight: 700; color: var(--primary);">🎮 Game Hub Mabar</h3>
      
      <div style="margin-top: 16px;">
        <label style="font-size: 0.8rem; font-weight: 600;">Pilih Permainan:</label>
        <select id="game-type-select">
          <option value="tictactoe">❌ Tic-Tac-Toe (3x3)</option>
          <option value="connect4">🔴 Connect 4 (Empat Beruntun)</option>
        </select>

        <label style="font-size: 0.8rem; font-weight: 600; margin-top: 8px; display: block;">Username Lawan:</label>
        <input type="text" id="invite-username-input" placeholder="Ketik username lawan...">
        <button class="btn-primary" onclick="sendInvite()">Kirim Undangan</button>
      </div>
    </div>
  </div>

  <div id="invite-received-modal" class="modal hidden">
    <div class="glass-card modal-content" style="text-align: center;">
      <h3 style="font-weight: 700; color: var(--primary);">⚔️ Undangan Mabar!</h3>
      <p id="invite-text" style="margin: 16px 0; font-size: 0.9rem; color: var(--text-muted);"></p>
      <div style="display: flex; gap: 10px;">
        <button class="btn-primary" style="margin: 0;" onclick="acceptInvite()">Terima</button>
        <button class="btn-secondary" style="background: #ef4444; color: white; border:none; flex: 1;" onclick="declineInvite()">Tolak</button>
      </div>
    </div>
  </div>

  <div id="game-arena-modal" class="modal hidden">
    <div class="glass-card modal-content" style="width: auto; text-align: center;">
      <span class="close-modal" onclick="closeModal('game-arena-modal')">&times;</span>
      <h3 style="font-weight: 700; color: var(--primary);">Tic-Tac-Toe</h3>
      <p id="game-status" style="margin-top: 6px; color: var(--primary); font-weight: 600; font-size: 0.88rem;">Menunggu Giliran...</p>
      <div class="board" id="board">
        <div class="cell" onclick="makeMove(0)"></div><div class="cell" onclick="makeMove(1)"></div><div class="cell" onclick="makeMove(2)"></div>
        <div class="cell" onclick="makeMove(3)"></div><div class="cell" onclick="makeMove(4)"></div><div class="cell" onclick="makeMove(5)"></div>
        <div class="cell" onclick="makeMove(6)"></div><div class="cell" onclick="makeMove(7)"></div><div class="cell" onclick="makeMove(8)"></div>
      </div>
      <button class="btn-secondary" onclick="closeModal('game-arena-modal')">Keluar</button>
    </div>
  </div>

  <div id="c4-arena-modal" class="modal hidden">
    <div class="glass-card modal-content" style="text-align: center;">
